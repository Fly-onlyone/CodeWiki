{
  "name": "Dracula",
  "author": "Zeno Rocha",
  "url": "https://draculatheme.com",
  "$schema": "https://github.com/longbridge/gpui-kit/raw/refs/heads/main/.theme-schema.json",
  "themes": [
    {
      "name": "Dracula",
      "mode": "dark",
      "font.family": "Inter",
      "font.size": 15,
      "mono_font.family": "JetBrains Mono",
      "mono_font.size": 13,
      "radius": 8,
      "radius.lg": 12,
      "shadow": true,
      "colors": {
        "accent.background": "#343746",
        "accent.foreground": "#F8F8F2",
        "background": "#282A36",
        "border": "#44475A",
        "window.border": "#44475A",
        "ring": "#BD93F9",
        "foreground": "#F8F8F2",
        "link": "#FC9ED1",
        "link.hover": "#FC9ED1",
        "link.active": "#FC9ED1",
        "list.active.background": "#BD93F924",
        "list.active.border": "#BD93F9",
        "list.even.background": "#21222C99",
        "list.hover.background": "#343746",
        "muted.background": "#21222C",
        "muted.foreground": "#A6B9EF",
        "popover.background": "#343746",
        "popover.foreground": "#F8F8F2",
        "primary.background": "#BD93F9",
        "primary.foreground": "#282A36",
        "secondary.background": "#21222C",
        "secondary.foreground": "#F8F8F2",
        "secondary.hover.background": "#343746",
        "secondary.active.background": "#44475A",
        "success.background": "#50FA7B",
        "success.foreground": "#282A36",
        "warning.background": "#F1FA8C",
        "warning.foreground": "#282A36",
        "danger.background": "#FCA39C",
        "danger.foreground": "#282A36",
        "info.background": "#8BE9FD",
        "info.foreground": "#282A36",
        "selection.background": "#BD93F940",
        "scrollbar.background": "#282A3600",
        "scrollbar.thumb.background": "#44475A",
        "sidebar.background": "#21222C",
        "sidebar.foreground": "#F8F8F2",
        "sidebar.border": "#44475A",
        "sidebar.accent.background": "#BD93F92E",
        "sidebar.accent.foreground": "#F8F8F2",
        "sidebar.primary.background": "#FFB86C",
        "sidebar.primary.foreground": "#282A36",
        "tab.foreground": "#A6B9EF",
        "tab.active.foreground": "#F8F8F2",
        "tab_bar.background": "#21222C",
        "title_bar.background": "#21222C",
        "title_bar.border": "#44475A",
        "chart.1": "#BD93F9",
        "chart.2": "#8BE9FD",
        "chart.3": "#50FA7B",
        "chart.4": "#F1FA8C",
        "chart.5": "#FC9ED1",
        "chart.grid": "#44475A",
        "base.red": "#FF5555",
        "base.green": "#50FA7B",
        "base.yellow": "#F1FA8C",
        "base.blue": "#BD93F9",
        "base.magenta": "#FC9ED1",
        "base.cyan": "#8BE9FD"
      },
      "highlight": {
        "editor.foreground": "#F8F8F2",
        "editor.background": "#282A36",
        "editor.active_line.background": "#21222C",
        "editor.line_number": "#A6B9EF",
        "editor.active_line_number": "#F8F8F2",
        "editor.invisible": "#6272a466",
        "conflict": "#ff5555",
        "created": "#50fa7b",
        "deleted": "#ff5555",
        "error": "#ff5555",
        "hidden": "#6272a4",
        "hint": "#8be9fd",
        "ignored": "#6272a4",
        "info": "#8be9fd",
        "modified": "#f1fa8c",
        "predictive": "#6272a4",
        "renamed": "#8be9fd",
        "success": "#50fa7b",
        "unreachable": "#6272a4",
        "warning": "#f1fa8c",
        "syntax": {
          "attribute": {
            "color": "#f1fa8c"
          },
          "boolean": {
            "color": "#ff79c6"
          },
          "comment": {
            "color": "#6272a4",
            "font_style": "italic"
          },
          "comment.doc": {
            "color": "#6272a4",
            "font_style": "italic"
          },
          "constant": {
            "color": "#ff79c6"
          },
          "constructor": {
            "color": "#f1fa8c"
          },
          "embedded": {
            "color": "#f8f8f2"
          },
          "function": {
            "color": "#8be9fd"
          },
          "keyword": {
            "color": "#ff5555"
          },
          "link_text": {
            "color": "#8be9fd",
            "font_style": "underline"
          },
          "link_uri": {
            "color": "#8be9fd",
            "font_style": "italic"
          },
          "number": {
            "color": "#ff79c6"
          },
          "string": {
            "color": "#50fa7b"
          },
          "string.escape": {
            "color": "#8be9fd"
          },
          "string.regex": {
            "color": "#50fa7b"
          },
          "string.special": {
            "color": "#f1fa8c"
          },
          "string.special.symbol": {
            "color": "#f1fa8c"
          },
          "tag": {
            "color": "#ff5555"
          },
          "text.literal": {
            "color": "#f8f8f2"
          },
          "title": {
            "color": "#8be9fd",
            "font_weight": 600
          },
          "type": {
            "color": "#8be9fd"
          },
          "property": {
            "color": "#f8f8f2"
          },
          "variable.special": {
            "color": "#ff5555"
          }
        }
      }
    }
  ]
}
