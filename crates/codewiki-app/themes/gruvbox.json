{
  "$schema": "https://github.com/longbridge/gpui-kit/raw/refs/heads/main/.theme-schema.json",
  "name": "Gruvbox",
  "author": "Pavel Pertsev",
  "url": "https://github.com/morhetz/gruvbox",
  "themes": [
    {
      "name": "Gruvbox Dark",
      "mode": "dark",
      "font.family": "Inter",
      "font.size": 15,
      "mono_font.family": "JetBrains Mono",
      "mono_font.size": 13,
      "radius": 8,
      "radius.lg": 12,
      "shadow": true,
      "colors": {
        "accent.background": "#3C3836",
        "accent.foreground": "#EBDBB2",
        "background": "#282828",
        "border": "#504945",
        "window.border": "#504945",
        "ring": "#FABD2F",
        "foreground": "#EBDBB2",
        "link": "#9FC1B4",
        "link.hover": "#9FC1B4",
        "link.active": "#9FC1B4",
        "list.active.background": "#FABD2F24",
        "list.active.border": "#FABD2F",
        "list.even.background": "#1D202199",
        "list.hover.background": "#3C3836",
        "muted.background": "#1D2021",
        "muted.foreground": "#C6B7A1",
        "popover.background": "#32302F",
        "popover.foreground": "#EBDBB2",
        "primary.background": "#FABD2F",
        "primary.foreground": "#282828",
        "secondary.background": "#1D2021",
        "secondary.foreground": "#EBDBB2",
        "secondary.hover.background": "#3C3836",
        "secondary.active.background": "#504945",
        "success.background": "#BDC02E",
        "success.foreground": "#282828",
        "warning.background": "#FCA46F",
        "warning.foreground": "#282828",
        "danger.background": "#FCA393",
        "danger.foreground": "#282828",
        "info.background": "#94C682",
        "info.foreground": "#282828",
        "selection.background": "#FABD2F40",
        "scrollbar.background": "#28282800",
        "scrollbar.thumb.background": "#504945",
        "sidebar.background": "#1D2021",
        "sidebar.foreground": "#EBDBB2",
        "sidebar.border": "#504945",
        "sidebar.accent.background": "#FABD2F2E",
        "sidebar.accent.foreground": "#EBDBB2",
        "sidebar.primary.background": "#F6A0C6",
        "sidebar.primary.foreground": "#282828",
        "tab.foreground": "#C6B7A1",
        "tab.active.foreground": "#EBDBB2",
        "tab_bar.background": "#1D2021",
        "title_bar.background": "#1D2021",
        "title_bar.border": "#504945",
        "chart.1": "#FABD2F",
        "chart.2": "#94C682",
        "chart.3": "#BDC02E",
        "chart.4": "#FCA46F",
        "chart.5": "#F3A3B9",
        "chart.grid": "#504945",
        "base.red": "#FB533E",
        "base.green": "#B8BB26",
        "base.yellow": "#FABD2F",
        "base.blue": "#83A598",
        "base.magenta": "#F3A3B9",
        "base.cyan": "#94C682"
      },
      "highlight": {
        "editor.foreground": "#EBDBB2",
        "editor.background": "#282828",
        "editor.active_line.background": "#1D2021",
        "editor.line_number": "#C6B7A1",
        "editor.active_line_number": "#EBDBB2",
        "editor.invisible": "#92837466",
        "conflict": "#f06555",
        "created": "#3f72e2",
        "deleted": "#9d0006",
        "error": "#cc241d",
        "hidden": "#9E9E9E",
        "hint": "#b283f8",
        "ignored": "#928374",
        "info": "#458588",
        "modified": "#B0A878",
        "predictive": "#5D5945",
        "renamed": "#b57614",
        "success": "#79740e",
        "unreachable": "#928374",
        "warning": "#d79921",
        "syntax": {
          "attribute": {
            "color": "#be9a52"
          },
          "boolean": {
            "color": "#E1D797"
          },
          "comment": {
            "color": "#9E9E9E"
          },
          "comment.doc": {
            "color": "#9E9E9E"
          },
          "constant": {
            "color": "#E1D797"
          },
          "constructor": {
            "color": "#b5af9a"
          },
          "embedded": {
            "color": "#CACCCA"
          },
          "function": {
            "color": "#E1D797"
          },
          "keyword": {
            "color": "#E19773"
          },
          "link_text": {
            "color": "#A86D3B",
            "font_style": "normal"
          },
          "link_uri": {
            "color": "#6F6D66",
            "font_style": "italic"
          },
          "number": {
            "color": "#E19773"
          },
          "string": {
            "color": "#76BA53"
          },
          "string.escape": {
            "color": "#76BA53"
          },
          "string.regex": {
            "color": "#76BA53"
          },
          "string.special": {
            "color": "#E1D797"
          },
          "string.special.symbol": {
            "color": "#E1D797"
          },
          "tag": {
            "color": "#b5af9a"
          },
          "text.literal": {
            "color": "#E1D797"
          },
          "title": {
            "color": "#A76D3B",
            "font_weight": 600
          },
          "type": {
            "color": "#A86D3B"
          },
          "property": {
            "color": "#CACCCA"
          },
          "variable.special": {
            "color": "#E19773"
          }
        }
      }
    }
  ]
}
