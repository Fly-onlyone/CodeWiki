{
  "name": "Nord",
  "author": "Sven Greb",
  "url": "https://www.nordtheme.com",
  "$schema": "https://github.com/longbridge/gpui-kit/raw/refs/heads/main/.theme-schema.json",
  "themes": [
    {
      "name": "Nord",
      "mode": "dark",
      "font.family": "Inter",
      "font.size": 15,
      "mono_font.family": "JetBrains Mono",
      "mono_font.size": 13,
      "radius": 8,
      "radius.lg": 12,
      "shadow": true,
      "colors": {
        "accent.background": "#434C5E",
        "accent.foreground": "#ECEFF4",
        "background": "#2E3440",
        "border": "#434C5E",
        "window.border": "#434C5E",
        "ring": "#88C0D0",
        "foreground": "#ECEFF4",
        "link": "#B2D4F6",
        "link.hover": "#B2D4F6",
        "link.active": "#B2D4F6",
        "list.active.background": "#88C0D024",
        "list.active.border": "#88C0D0",
        "list.even.background": "#3B425299",
        "list.hover.background": "#434C5E",
        "muted.background": "#3B4252",
        "muted.foreground": "#D8DEE9",
        "popover.background": "#3B4252",
        "popover.foreground": "#ECEFF4",
        "primary.background": "#88C0D0",
        "primary.foreground": "#2E3440",
        "secondary.background": "#3B4252",
        "secondary.foreground": "#ECEFF4",
        "secondary.hover.background": "#434C5E",
        "secondary.active.background": "#4C566A",
        "success.background": "#BCD8A5",
        "success.foreground": "#2E3440",
        "warning.background": "#EBCB8B",
        "warning.foreground": "#2E3440",
        "danger.background": "#FDBFC2",
        "danger.foreground": "#2E3440",
        "info.background": "#AAD7D6",
        "info.foreground": "#2E3440",
        "selection.background": "#88C0D040",
        "scrollbar.background": "#2E344000",
        "scrollbar.thumb.background": "#434C5E",
        "sidebar.background": "#2E3440",
        "sidebar.foreground": "#ECEFF4",
        "sidebar.border": "#434C5E",
        "sidebar.accent.background": "#88C0D02E",
        "sidebar.accent.foreground": "#ECEFF4",
        "sidebar.primary.background": "#EBC3E4",
        "sidebar.primary.foreground": "#2E3440",
        "tab.foreground": "#D8DEE9",
        "tab.active.foreground": "#ECEFF4",
        "tab_bar.background": "#2E3440",
        "title_bar.background": "#2E3440",
        "title_bar.border": "#434C5E",
        "chart.1": "#88C0D0",
        "chart.2": "#AAD7D6",
        "chart.3": "#BCD8A5",
        "chart.4": "#EBCB8B",
        "chart.5": "#EBC3E4",
        "chart.grid": "#434C5E",
        "base.red": "#DF7E86",
        "base.green": "#A3BE8C",
        "base.yellow": "#EBCB8B",
        "base.blue": "#81A1C1",
        "base.magenta": "#EBC3E4",
        "base.cyan": "#A0D8E9"
      },
      "highlight": {
        "editor.foreground": "#ECEFF4",
        "editor.background": "#2E3440",
        "editor.active_line.background": "#3B4252",
        "editor.line_number": "#D8DEE9",
        "editor.active_line_number": "#ECEFF4",
        "editor.invisible": "#7b88a166",
        "conflict": "#bf616a",
        "created": "#a3be8c",
        "deleted": "#bf616a",
        "error": "#bf616a",
        "hidden": "#7b88a1",
        "hint": "#8fbcbb",
        "ignored": "#7b88a1",
        "info": "#81a1c1",
        "modified": "#ebcb8b",
        "predictive": "#7b88a1",
        "renamed": "#81a1c1",
        "success": "#a3be8c",
        "unreachable": "#7b88a1",
        "warning": "#ebcb8b",
        "syntax": {
          "attribute": {
            "color": "#ebcb8b"
          },
          "boolean": {
            "color": "#b48ead"
          },
          "comment": {
            "color": "#7b88a1",
            "font_style": "italic"
          },
          "comment.doc": {
            "color": "#7b88a1",
            "font_style": "italic"
          },
          "constant": {
            "color": "#b48ead"
          },
          "constructor": {
            "color": "#ebcb8b"
          },
          "embedded": {
            "color": "#d8dee9"
          },
          "function": {
            "color": "#81a1c1"
          },
          "keyword": {
            "color": "#bf616a"
          },
          "link_text": {
            "color": "#8fbcbb",
            "font_style": "underline"
          },
          "link_uri": {
            "color": "#81a1c1",
            "font_style": "italic"
          },
          "number": {
            "color": "#b48ead"
          },
          "string": {
            "color": "#a3be8c"
          },
          "string.escape": {
            "color": "#8fbcbb"
          },
          "string.regex": {
            "color": "#a3be8c"
          },
          "string.special": {
            "color": "#ebcb8b"
          },
          "string.special.symbol": {
            "color": "#ebcb8b"
          },
          "tag": {
            "color": "#bf616a"
          },
          "text.literal": {
            "color": "#d8dee9"
          },
          "title": {
            "color": "#81a1c1",
            "font_weight": 600
          },
          "type": {
            "color": "#8fbcbb"
          },
          "property": {
            "color": "#d8dee9"
          },
          "variable.special": {
            "color": "#bf616a"
          }
        }
      }
    }
  ]
}
