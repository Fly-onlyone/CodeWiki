        "sidebar.border": "#403D52",
        "sidebar.accent.background": "#C4A7E72E",
        "sidebar.accent.foreground": "#E0DEF4",
        "sidebar.primary.background": "#9CCFD8",
        "sidebar.primary.foreground": "#191724",
