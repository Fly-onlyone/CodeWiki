            "color": "#9ccfd8"
          },
          "string.special": {
            "color": "#f6c177"
          },
          "string.special.symbol": {
            "color": "#f6c177"
          },
          "tag": {
            "color": "#eb6f92"
          },
          "text.literal": {
            "color": "#e0def4"
          },
          "title": {
            "color": "#31748f",
            "font_weight": 600
