root = Card([summary, flow], "codewiki Startup Flow")
summary = TextContent("Call sequence from the `main` entry point of `codewiki` across 10 parts of the codebase.", "muted")
flow = Steps([s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13])
s0 = Step("init()", "codewiki calls into Logs Module")
s1 = Step("init_console()", "codewiki calls into Logs Module")
s2 = Step("worker()", "codewiki calls into cw-embed-engine")
s3 = Step("run()", "codewiki calls into Model Module (codewiki)")
s4 = Step("run()", "codewiki calls into Serve Module")
s5 = Step("invalid()", "codewiki calls into Error")
s6 = Step("io()", "codewiki calls into Error")
s7 = Step("not_found()", "codewiki calls into Error")
s8 = Step("data_dir()", "codewiki calls into Paths Module")
s9 = Step("load()", "codewiki calls into Resolved")
s10 = Step("search()", "codewiki calls into cw-index")
s11 = Step("files()", "codewiki calls into Index")
s12 = Step("find_symbols()", "codewiki calls into Index")
s13 = Step("symbols()", "codewiki calls into Index")
