root = Card([summary, flow], "codewiki Startup Flow")
summary = TextContent("Call sequence from the `main` entry point of `codewiki` across 10 parts of the codebase.", "muted")
flow = Steps([s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13])
s0 = Step("run()", "codewiki calls into Serve Module")
s1 = Step("invalid()", "codewiki calls into Error")
s2 = Step("io()", "codewiki calls into Error")
s3 = Step("not_found()", "codewiki calls into Error")
s4 = Step("data_dir()", "codewiki calls into Paths Module")
s5 = Step("search()", "codewiki calls into cw-index")
s6 = Step("find_symbols()", "codewiki calls into Index")
s7 = Step("writer_from_env()", "codewiki calls into cw-llm")
s8 = Step("workspace()", "codewiki calls into Workspace Module (cw-server)")
s9 = Step("workspace_contracts()", "codewiki calls into Workspace Module (cw-server)")
s10 = Step("load()", "codewiki calls into VaultMeta")
s11 = Step("save()", "codewiki calls into VaultMeta")
s12 = Step("approve()", "codewiki calls into Proposal Module")
s13 = Step("list()", "codewiki calls into Proposal Module")
