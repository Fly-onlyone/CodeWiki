root = Card([flow])
flow = Steps([s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13])
s0 = Step("init()", "codewiki calls into cw-telemetry")
s1 = Step("init_console()", "codewiki calls into Logs Module")
s2 = Step("vault_root()", "codewiki calls into Briefing Module")
s3 = Step("session_start()", "codewiki calls into Briefing Module")
s4 = Step("worker()", "codewiki calls into cw-embed-engine")
s5 = Step("sending()", "codewiki calls into cw-telemetry")
s6 = Step("data_dir()", "codewiki calls into Paths Module")
s7 = Step("send_test_report()", "codewiki calls into cw-telemetry")
s8 = Step("init_with()", "cw-telemetry calls into Logs Module")
s9 = Step("run()", "codewiki calls into Serve Module")
s10 = Step("run()", "codewiki calls into Model Module (codewiki)")
s11 = Step("io()", "codewiki calls into Error")
s12 = Step("load()", "codewiki calls into Resolved")
s13 = Step("configure()", "codewiki calls into Semantic Module")
