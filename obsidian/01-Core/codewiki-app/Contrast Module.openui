root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "10")
f1 = Stat("Used by notes", "3")
f2 = Stat("Depends on notes", "0")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("parse_hex", "Called by debug_backdrop, parse_rgba.")
s1 = Step("over", "Called by matched_backdrop, nudge_texts.")
s2 = Step("fit_alpha", "Called by Levels::compute, nudge_texts. Calls ratio, then worst_ratio.")
s3 = Step("ratio", "Called by readable_on, standard_colors. Calls luminance.")
s4 = Step("worst_ratio", "Called by nudge_texts. Calls ratio, then over.")
