root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "12")
f1 = Stat("Used by notes", "1")
f2 = Stat("Depends on notes", "1")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("fit", "Called by AppView::diagram_viewer_view. Calls placed.")
s1 = Step("actual", "Called by AppView::diagram_viewer_view. Calls placed.")
s2 = Step("zoom_by", "Called by AppView::diagram_viewer_view, AppView::zoom_diagram.")
s3 = Step("clamp", "Called by AppView::move_diagram.")
s4 = Step("frame", "Called by AppView::diagram_viewer_view.")
