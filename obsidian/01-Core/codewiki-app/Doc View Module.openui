root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "12")
f1 = Stat("Used by notes", "6")
f2 = Stat("Depends on notes", "28")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("notify_after_draw", "Called by AppView::diagram_viewer_view, AppView::render and 1 more.")
s1 = Step("DocPage::new", "Called by AppView::new. Calls strips, then factor.")
s2 = Step("column", "Called by AppView::settings_frame. Calls px, then text, then Enter::card, then draw.")
s3 = Step("choice_tint", "Called by AppView::settings_menu_view. Calls entries, then glyph_tint, then tint.")
s4 = Step("stat_tile", "Called by render. Calls card, then px, then card_content, then text and 1 more.")
