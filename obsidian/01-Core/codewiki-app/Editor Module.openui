root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "3")
f1 = Stat("Used by notes", "1")
f2 = Stat("Depends on notes", "0")
flow = Steps([s0, s1, s2])
s0 = Step("wikilink_query", "Called by AppView::edit_view.")
s1 = Step("completions", "Called by AppView::edit_view.")
s2 = Step("restore_line_endings", "Called by AppView::save_edit.")
