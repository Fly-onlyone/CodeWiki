root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "11")
f1 = Stat("Used by notes", "5")
f2 = Stat("Depends on notes", "2")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("tinted_border", "Called by AppView::details, AppView::sidebar and 7 more.")
s1 = Step("hairline", "Called by AppView::body, AppView::palette_view and 4 more.")
s2 = Step("matched_backdrop", "Called by nudge_texts. Calls over.")
s3 = Step("Levels::for_window", "Called by AppView::render, title_bar. Calls Levels::compute, then rgb, then tint.")
s4 = Step("tint", "Called by style.")
