s1 = Step("GraphData::stress", "Called by AppView::open_graph. Calls GraphData::new.")
s2 = Step("Camera::fit", "Called by AppView::graph_view.")
s3 = Step("radius", "Called by AppView::graph_view.")
s4 = Step("pick", "Called by AppView::graph_view. Calls radius.")
