root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "13")
f1 = Stat("Used by notes", "1")
f2 = Stat("Depends on notes", "2")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("symbol_page", "Called by AppView::open_symbol. Calls Doc::new, then string, then text, then file and 6 more.")
s1 = Step("search_page", "Called by AppView::run_search. Calls Doc::new, then list, then string, then Row::new and 3 more.")
s2 = Step("hotspots_page", "Called by AppView::open_hotspots. Calls list, then Doc::new, then Table::new, then Column::new and 5 more.")
s3 = Step("file_page", "Called by AppView::open_file. Calls string, then Doc::new, then Stat::new, then number and 10 more.")
s4 = Step("proposal_page", "Called by AppView::open_proposal. Calls Doc::new, then code, then string, then text.")
