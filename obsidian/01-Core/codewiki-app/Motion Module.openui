root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "4")
f1 = Stat("Used by notes", "1")
f2 = Stat("Depends on notes", "2")
flow = Steps([s0, s1, s2])
s0 = Step("init", "Called by main. Calls read, then MotionPref::parse.")
s1 = Step("current", "Called by AppView::settings_frame.")
s2 = Step("set", "Called by AppView::run_action, AppView::run_command. Calls write.")
