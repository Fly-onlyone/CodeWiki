root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "4")
f1 = Stat("Used by notes", "2")
f2 = Stat("Depends on notes", "2")
flow = Steps([s0, s1, s2])
s0 = Step("Entry::new", "Called by AppView::palette_matches.")
s1 = Step("actions", "Called by AppView::palette_matches. Calls Entry::new.")
s2 = Step("filter", "Called by AppView::palette_matches. Calls rank, then Entry::new.")
