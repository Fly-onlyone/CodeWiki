root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "3")
f1 = Stat("Used by notes", "1")
f2 = Stat("Depends on notes", "1")
flow = Steps([s0, s1])
s0 = Step("load", "Called by AppView::new. Calls is_open, then read.")
s1 = Step("store", "Called by AppView::toggle_pane. Calls write.")
