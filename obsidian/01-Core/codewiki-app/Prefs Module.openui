root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "3")
f1 = Stat("Used by notes", "9")
f2 = Stat("Depends on notes", "0")
flow = Steps([s0, s1, s2])
s0 = Step("read", "Called by AppView::after_hide, main and 10 more. Calls read_in, then dir.")
s1 = Step("write", "Called by AppView::after_hide, AppView::run_settings_action and 10 more. Calls dir, then write_in.")
s2 = Step("dir", "Called by acquire, user_theme_dir.")
