root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "3")
f1 = Stat("Used by notes", "1")
f2 = Stat("Depends on notes", "7")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("State::new", "Called by AppView::new. Calls read.")
s1 = Step("shown_value", "Called by AppView::take_settings.")
s2 = Step("test_line", "Called by AppView::test_setting.")
s3 = Step("lists_themes", "Called by AppView::settings_menu_view.")
s4 = Step("change", "Called by AppView::commit_settings_field, AppView::run_settings_action.")
