root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "10")
f1 = Stat("Used by notes", "2")
f2 = Stat("Depends on notes", "2")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("launch", "Called by AppView::listen, AppView::new and 3 more. Calls parse_args.")
s1 = Step("named_repo", "Called by Request::new. Calls looks_like_repo.")
s2 = Step("open_last", "Called by AppView::open_startup_view, AppView::settings_frame. Calls read.")
s3 = Step("set_open_last", "Called by AppView::run_action. Calls write.")
s4 = Step("repo", "Called by AppView::connect. Calls choose, then launch, then read.")
