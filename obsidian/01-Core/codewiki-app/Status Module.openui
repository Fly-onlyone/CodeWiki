root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "9")
f1 = Stat("Used by notes", "2")
f2 = Stat("Depends on notes", "0")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("parse", "Called by AppView::take_status. Calls model_job_text.")
s1 = Step("state_with_job", "Called by AppView::tray_snapshot.")
s2 = Step("mcp_text", "Called by AppView::tray_snapshot. Calls ago.")
s3 = Step("state_text", "Called by AppView::tray_snapshot.")
s4 = Step("tooltip", "Called by tooltip. Calls cut_utf16.")
