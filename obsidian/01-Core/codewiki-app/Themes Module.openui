root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "10")
f1 = Stat("Used by notes", "7")
f2 = Stat("Depends on notes", "5")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("Brand::of", "Called by Shell::shapes, ListItemButton::render.")
s1 = Step("brand", "Called by subheader, frame and 1 more. Calls Brand::of.")
s2 = Step("glyph_tint", "Called by theme_menu_item, choice_tint. Calls to_hsla, then readable_on, then to_rgb.")
s3 = Step("entries", "Called by AppView::open_theme_menu, AppView::palette_matches and 4 more.")
s4 = Step("init", "Called by main. Calls Baseline::capture, then user_theme_dir, then catalog, then swatches and 5 more.")
