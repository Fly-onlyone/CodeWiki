root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "5")
f1 = Stat("Used by notes", "2")
f2 = Stat("Depends on notes", "5")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("State::from_check", "Called by AppView::show_check.")
s1 = Step("auto_check", "Called by AppView::start_updates, AppView::settings_frame. Calls read.")
s2 = Step("set_auto_check", "Called by AppView::run_action. Calls write.")
s3 = Step("due", "Called by AppView::start_updates. Calls due_after, then read, then now.")
s4 = Step("check", "Called by AppView::check_for_update, AppView::start_updates. Calls check, then api_base, then write, then now.")
