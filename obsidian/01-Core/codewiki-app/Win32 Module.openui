root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "10")
f1 = Stat("Used by notes", "4")
f2 = Stat("Depends on notes", "3")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("hwnd", "Called by AppView::listen, AppView::start_tray.")
s1 = Step("hide", "Called by AppView::listen.")
s2 = Step("show", "Called by AppView::listen.")
s3 = Step("is_visible", "Called by AppView::listen.")
s4 = Step("keep_open", "Called by Tray::new.")
