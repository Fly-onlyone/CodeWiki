root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "22")
f1 = Stat("Used by notes", "21")
f2 = Stat("Depends on notes", "3")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("px", "Called by AppView::body, AppView::details and 61 more. Calls factor.")
s1 = Step("label", "Called by title_bar, zoom_card.")
s2 = Step("step_by", "Called by AppView::run_command, main and 1 more. Calls set, then step, then percent.")
s3 = Step("factor", "Called by DocPage::new, DocPage::render.")
s4 = Step("set_factor", "Called by Restore::drop.")
