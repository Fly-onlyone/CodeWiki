root = Card([summary, figures, chart], "codewiki-app")
summary = TextContent("CodeWiki desktop app for Windows.", "muted")
figures = Grid([f0, f1, f2, f3], 4)
f0 = Stat("Modules", "49")
f1 = Stat("Public types", "89")
f2 = Stat("Functions", "664")
f3 = Stat("Used by crates", "0")
chart = BarChart(["mui", "doc", "doc_view", "standard", "settings_view", "settings_pages", "instance", "themes"], [Series("Symbols per module", [359, 56, 50, 37, 36, 35, 29, 26])], "Symbols per module")
