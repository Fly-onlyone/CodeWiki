root = Card([summary, figures, chart], "codewiki-app")
summary = TextContent("CodeWiki desktop app for Windows.", "muted")
figures = Grid([f0, f1, f2, f3], 4)
f0 = Stat("Modules", "37")
f1 = Stat("Public types", "59")
f2 = Stat("Functions", "485")
f3 = Stat("Used by crates", "0")
chart = BarChart(["mui", "doc", "doc_view", "standard", "themes", "graph", "glass", "backdrop"], [Series("Symbols per module", [297, 48, 39, 37, 26, 23, 22, 20])], "Symbols per module")
