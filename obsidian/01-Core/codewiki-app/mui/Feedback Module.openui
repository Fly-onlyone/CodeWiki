root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "9")
f1 = Stat("Used by notes", "4")
f2 = Stat("Depends on notes", "4")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("chip", "Called by AppView::graph_view, title_bar and 3 more. Calls px.")
s1 = Step("alert", "Called by AppView::page_view, AppView::viewer and 2 more. Calls px.")
s2 = Step("linear_progress", "Called by AppView::body, draw. Calls px, then scaled, then indeterminate.")
s3 = Step("alert_action", "Called by draw. Calls px.")
s4 = Step("dots", "Called by theme_menu_item. Calls px.")
