f1 = Stat("Used by notes", "3")
f2 = Stat("Depends on notes", "8")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("subheader", "Called by AppView::sidebar, Menu::render. Calls px, then brand.")
s1 = Step("fill", "Called by ListItemButton::render.")
s2 = Step("bar_glow", "Called by ListItemButton::render. Calls px.")
s3 = Step("icon_color", "Called by ListItemButton::render.")
s4 = Step("ListFolder::new", "Called by AppView::sidebar.")
