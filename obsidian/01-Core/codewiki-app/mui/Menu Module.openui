root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "7")
f1 = Stat("Used by notes", "3")
f2 = Stat("Depends on notes", "8")
flow = Steps([s0, s1, s2, s3])
s0 = Step("Menu::new", "Called by AppView::theme_menu_view, menu.")
s1 = Step("MenuItem::new", "Called by AppView::settings_menu_view, theme_menu_item.")
s2 = Step("MenuSection::new", "Called by AppView::theme_menu_view, AppView::settings_menu_view.")
s3 = Step("MenuSection::plain", "Called by AppView::settings_menu_view.")
