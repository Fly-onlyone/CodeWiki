root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "22")
f1 = Stat("Used by notes", "16")
f2 = Stat("Depends on notes", "6")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("scaled", "Called by AppView::render, AppView::forget_saved_note and 15 more. Calls scale.")
s1 = Step("scale", "Called by Spring::config. Calls parse_scale.")
s2 = Step("drawer", "Called by AppView::render. Calls scaled, then easing.")
s3 = Step("count_up", "Called by stat_tile.")
s4 = Step("stagger_delay", "Called by Enter::card, Enter::row.")
