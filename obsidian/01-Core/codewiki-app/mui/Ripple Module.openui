root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "11")
f1 = Stat("Used by notes", "1")
f2 = Stat("Depends on notes", "4")
flow = Steps([s0, s1, s2])
s0 = Step("Wave::new", "Called by Touch::press.")
s1 = Step("paint", "Called by Base::attach. Calls px, then rounded_rect, then origin, then size and 3 more.")
s2 = Step("paint_pressed", "Called by Base::attach. Calls px.")
