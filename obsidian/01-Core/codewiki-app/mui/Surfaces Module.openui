root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "9")
f1 = Stat("Used by notes", "4")
f2 = Stat("Depends on notes", "3")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("text", "Called by AppView::details, AppView::diagram_viewer_view and 13 more. Calls px.")
s1 = Step("card", "Called by code_block, draw and 4 more. Calls tinted_border, then card_fill, then card_shadow, then hairline.")
s2 = Step("card_content", "Called by draw, empty and 2 more. Calls px.")
s3 = Step("paper", "Called by AppView::diagram_viewer_view, AppView::palette_view and 1 more. Calls tinted_border, then elevation.")
s4 = Step("divider", "Called by AppView::diagram_viewer_view, render. Calls px.")
