root = Card([summary, figures, chart], "codewiki")
summary = TextContent("CodeWiki command line and backend server.", "muted")
figures = Grid([f0, f1, f2, f3], 4)
f0 = Stat("Modules", "6")
f1 = Stat("Public types", "1")
f2 = Stat("Functions", "47")
f3 = Stat("Used by crates", "0")
chart = BarChart(["model", "serve"], [Series("Symbols per module", [10, 8])], "Symbols per module")
