root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "8")
f1 = Stat("Used by notes", "3")
f2 = Stat("Depends on notes", "1")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("saved_in", "Called by saved_remote, Backend::named. Calls read.")
s1 = Step("token_in", "Called by check_remote_in, Backend::named. Calls read, then unprotect.")
s2 = Step("normalized", "Called by check_remote_in.")
s3 = Step("save_in", "Called by save_remote. Calls normalized, then protect, then hint, then read and 1 more.")
s4 = Step("set_in_use_in", "Called by use_local. Calls read, then write.")
