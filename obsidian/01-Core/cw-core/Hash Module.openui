root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "4")
f1 = Stat("Used by notes", "7")
f2 = Stat("Depends on notes", "0")
flow = Steps([s0, s1, s2, s3])
s0 = Step("sha256_hex", "Called by repo_id, scan_repo and 3 more.")
s1 = Step("hmac_sha256", "Called by webhook_signed.")
s2 = Step("constant_time_eq", "Called by require_token, webhook_signed.")
s3 = Step("normalize_text", "Called by body_hash.")
