root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "17")
f1 = Stat("Used by notes", "11")
f2 = Stat("Depends on notes", "3")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("dir", "Called by AppView::connect, AppView::open_logs and 2 more. Calls dir_from.")
s1 = Step("path", "Called by AppView::connect, Backend::connect. Calls dir.")
s2 = Step("level_named", "Called by main, AppView::run_settings_action.")
s3 = Step("level_name", "Called by AppView::settings_frame.")
s4 = Step("level_in_env", "Called by AppView::settings_frame. Calls level_named.")
