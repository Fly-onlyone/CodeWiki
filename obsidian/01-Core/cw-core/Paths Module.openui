root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "5")
f1 = Stat("Used by notes", "11")
f2 = Stat("Depends on notes", "1")
flow = Steps([s0, s1, s2, s3])
s0 = Step("data_dir", "Called by run, sentry_test and 16 more.")
s1 = Step("repo_id", "Called by add. Calls sha256_hex.")
s2 = Step("index_path", "Called by open_index. Calls index_path_in, then data_dir.")
s3 = Step("index_path_in", "Called by open_existing_index_in, open_index_in. Calls repo_id.")
