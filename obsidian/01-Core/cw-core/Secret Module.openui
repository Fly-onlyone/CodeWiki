root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "4")
f1 = Stat("Used by notes", "4")
f2 = Stat("Depends on notes", "3")
flow = Steps([s0, s1, s2, s3])
s0 = Step("protect", "Called by save_in, Settings::set. Calls Error::invalid, then protect.")
s1 = Step("unprotect", "Called by token_in, Resolved::saved_secret. Calls Error::invalid, then unprotect.")
s2 = Step("hint", "Called by save_in, Settings::set.")
s3 = Step("available", "Called by apply, describe.")
