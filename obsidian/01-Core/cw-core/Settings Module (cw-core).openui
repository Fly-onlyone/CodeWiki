root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "24")
f1 = Stat("Used by notes", "8")
f2 = Stat("Depends on notes", "4")
flow = Steps([s0, s1, s2, s3])
s0 = Step("load", "Called by resolved, Resolved::load. Calls read.")
s1 = Step("key_at", "Called by change.")
s2 = Step("update", "Called by change. Calls file, then read, then Error::io, then Error::external.")
s3 = Step("process_env", "Called by store.")
