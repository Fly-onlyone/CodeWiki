root = Card([summary, figures, chart], "cw-core")
summary = TextContent("Shared identifiers, hashing, configuration and error types for CodeWiki.", "muted")
figures = Grid([f0, f1, f2, f3], 4)
f0 = Stat("Modules", "8")
f1 = Stat("Public types", "15")
f2 = Stat("Functions", "91")
f3 = Stat("Used by crates", "14")
chart = BarChart(["settings", "logs", "model", "secret", "error", "hash", "paths"], [Series("Symbols per module", [46, 36, 23, 14, 6, 5, 5])], "Symbols per module")
