root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "2")
f1 = Stat("Used by notes", "1")
f2 = Stat("Depends on notes", "0")
flow = Steps([s0, s1])
s0 = Step("LayoutOptions::default", "Called by analyze.")
s1 = Step("force_layout", "Called by analyze. Calls QuadTree::build.")
