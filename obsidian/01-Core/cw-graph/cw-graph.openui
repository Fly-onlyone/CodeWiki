root = Card([summary, figures, chart], "cw-graph")
summary = TextContent("Graph construction, metrics, community detection and layout for CodeWiki.", "muted")
figures = Grid([f0, f1, f2, f3], 4)
f0 = Stat("Modules", "4")
f1 = Stat("Public types", "2")
f2 = Stat("Functions", "22")
f3 = Stat("Used by crates", "1")
chart = BarChart(["layout", "graph", "metrics", "community"], [Series("Symbols per module", [13, 8, 5, 4])], "Symbols per module")
