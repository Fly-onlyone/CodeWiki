root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "1")
f1 = Stat("Used by notes", "2")
f2 = Stat("Depends on notes", "2")
flow = Steps([s0, s1, s2])
s0 = Step("from_blob", "Called by Index::nearest.")
s1 = Step("delete", "Called by Index::prune_vectors, Index::store_vectors. Calls db.")
s2 = Step("upsert", "Called by Index::store_vectors, Index::upsert_vectors. Calls db, then to_blob.")
