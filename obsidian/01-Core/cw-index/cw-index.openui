root = Card([summary, figures, chart], "cw-index")
summary = TextContent("SQLite index: files, symbols, edges, metrics and full-text search for CodeWiki.", "muted")
figures = Grid([f0, f1, f2, f3], 4)
f0 = Stat("Modules", "4")
f1 = Stat("Public types", "5")
f2 = Stat("Functions", "31")
f3 = Stat("Used by crates", "4")
chart = BarChart(["store", "vectors", "search", "schema"], [Series("Symbols per module", [25, 7, 5, 3])], "Symbols per module")
