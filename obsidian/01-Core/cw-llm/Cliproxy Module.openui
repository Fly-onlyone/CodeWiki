root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "4")
f1 = Stat("Used by notes", "3")
f2 = Stat("Depends on notes", "3")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("unreachable", "Called by CliProxy::send. Calls base.")
s1 = Step("base", "Called by CliProxy::send.")
s2 = Step("panel", "Called by describe. Calls base.")
s3 = Step("exhausted", "Called by CliProxy::send.")
s4 = Step("reachable", "Called by describe. Calls exchange, then unreachable, then base.")
