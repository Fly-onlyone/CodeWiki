root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "24")
f1 = Stat("Used by notes", "12")
f2 = Stat("Depends on notes", "11")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("from_settings", "Called by writer_from, writer_name and 3 more. Calls from_config.")
s1 = Step("post_json", "Called by Anthropic::send, Ollama::send and 1 more. Calls exchange, then http_error.")
s2 = Step("exchange", "Called by models, reachable and 1 more. Calls agent, then Error::external.")
s3 = Step("http_error", "Called by models, CliProxy::send. Calls Error::external.")
s4 = Step("chat_request", "Called by CliProxy::send, OpenAiCompatible::send.")
