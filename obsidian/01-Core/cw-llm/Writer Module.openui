root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "2")
f1 = Stat("Used by notes", "1")
f2 = Stat("Depends on notes", "4")
flow = Steps([s0, s1, s2, s3])
s0 = Step("guidance", "Called by LlmWriter::rewrite. Calls max_words.")
s1 = Step("read_sources", "Called by LlmWriter::rewrite.")
s2 = Step("kind_hint", "Called by LlmWriter::rewrite.")
s3 = Step("extract_note", "Called by LlmWriter::rewrite.")
