root = Card([summary, figures, chart], "cw-llm")
summary = TextContent("LLM providers and the prose writer for CodeWiki.", "muted")
figures = Grid([f0, f1, f2, f3], 4)
f0 = Stat("Modules", "5")
f1 = Stat("Public types", "7")
f2 = Stat("Functions", "38")
f3 = Stat("Used by crates", "2")
chart = BarChart(["provider", "writer", "answer", "illustrate"], [Series("Symbols per module", [30, 14, 6, 3])], "Symbols per module")
