root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "4")
f1 = Stat("Used by notes", "3")
f2 = Stat("Depends on notes", "4")
flow = Steps([s0, s1])
s0 = Step("io", "Called by Store::install. Calls Error::io.")
s1 = Step("fetch", "Called by Store::install. Calls io, then sha256_of, then agent, then Error::external and 1 more.")
