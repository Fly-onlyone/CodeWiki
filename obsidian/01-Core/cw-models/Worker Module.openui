root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "16")
f1 = Stat("Used by notes", "7")
f2 = Stat("Depends on notes", "7")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("cuda_program", "Called by recommend, BuiltinEmbedder::new.")
s1 = Step("cuda_usable", "Called by describe, describe. Calls cuda_program, then nvidia_card.")
s2 = Step("global", "Called by describe, remove and 3 more. Calls Supervisor::new.")
s3 = Step("serve", "Called by worker.")
s4 = Step("refuse", "Called by worker.")
