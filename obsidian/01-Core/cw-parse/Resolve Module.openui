root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "3")
f1 = Stat("Used by notes", "4")
f2 = Stat("Depends on notes", "2")
flow = Steps([s0, s1, s2])
s0 = Step("leaves", "Called by Resolver::resolve.")
s1 = Step("home_module", "Called by Resolver::by_bare_name.")
s2 = Step("visible_from", "Called by Resolver::by_bare_name. Calls home_module, then is_separate_target, then within.")
