root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "9")
f1 = Stat("Used by notes", "7")
f2 = Stat("Depends on notes", "2")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("module_path", "Called by scan_repo, command. Calls owning_crate, then segments_of.")
s1 = Step("parse_manifest", "Called by scan_repo. Calls Error::external, then dependency_names.")
s2 = Step("dependency_specs", "Called by cargo. Calls dep_spec.")
s3 = Step("locked_versions", "Called by Packages::read.")
s4 = Step("package_description", "Called by Machine::describe.")
