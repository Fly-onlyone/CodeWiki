root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "11")
f1 = Stat("Used by notes", "4")
f2 = Stat("Depends on notes", "20")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("lock", "Called by Jobs::begin, Jobs::change and 3 more.")
s1 = Step("describe", "Called by read_models. Calls hardware, then cuda_usable, then store, then chosen and 3 more.")
s2 = Step("start", "Called by start_model_job. Calls unavailable, then store, then Error::invalid, then run.")
s3 = Step("remove", "Called by remove_model. Calls unavailable, then entry, then Error::invalid, then chosen and 4 more.")
s4 = Step("after_update", "Called by run_update. Calls open_existing_index_in, then behind, then unavailable, then start.")
