root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "5")
f1 = Stat("Used by notes", "3")
f2 = Stat("Depends on notes", "3")
flow = Steps([s0, s1, s2, s3])
s0 = Step("load", "Called by git_hook, list_repos and 4 more. Calls file, then Error::external, then Error::io.")
s1 = Step("add", "Called by add_repo. Calls Error::invalid, then load, then repo_id, then save.")
s2 = Step("remove", "Called by remove_repo. Calls load, then Error::not_found, then save.")
s3 = Step("get", "Called by Repo::open, get_repo and 1 more. Calls load, then Error::not_found.")
