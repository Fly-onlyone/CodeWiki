root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "5")
f1 = Stat("Used by notes", "4")
f2 = Stat("Depends on notes", "13")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("resolved", "Called by serve, ask and 5 more. Calls Resolved::from_parts, then load.")
s1 = Step("change", "Called by write_settings, remove and 1 more. Calls Error::invalid, then resolved, then update, then key_at and 5 more.")
s2 = Step("describe", "Called by read_settings. Calls resolved, then available, then cuda_usable, then selected and 2 more.")
s3 = Step("test_llm", "Called by test_llm. Calls from_settings, then resolved, then test_result, then Error::invalid.")
s4 = Step("test_embedder", "Called by test_embedder. Calls from_settings_in, then resolved, then test_result, then Error::invalid.")
