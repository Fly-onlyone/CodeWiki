root = Card([summary, figures, chart], "cw-server")
summary = TextContent("HTTP API of the CodeWiki backend.", "muted")
figures = Grid([f0, f1, f2, f3], 4)
f0 = Stat("Modules", "8")
f1 = Stat("Public types", "8")
f2 = Stat("Functions", "198")
f3 = Stat("Used by crates", "1")
chart = BarChart(["api", "models", "settings", "workspace", "activity", "repos"], [Series("Symbols per module", [98, 38, 11, 11, 8, 7])], "Symbols per module")
