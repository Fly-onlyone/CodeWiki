root = Card([summary, figures, chart], "cw-server")
summary = TextContent("HTTP API of the CodeWiki backend.", "muted")
figures = Grid([f0, f1, f2, f3], 4)
f0 = Stat("Modules", "4")
f1 = Stat("Public types", "7")
f2 = Stat("Functions", "87")
f3 = Stat("Used by crates", "1")
chart = BarChart(["api", "workspace", "repos"], [Series("Symbols per module", [80, 11, 7])], "Symbols per module")
