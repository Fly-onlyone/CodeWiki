root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "3")
f1 = Stat("Used by notes", "2")
f2 = Stat("Depends on notes", "1")
flow = Steps([s0, s1, s2])
s0 = Step("swap", "Called by install. Calls old_name, then write_journal, then rename_patiently, then undo and 2 more.")
s1 = Step("recover_and_clean", "Called by AppView::start_updates. Calls journal_path, then undo, then replaced_name, then remove and 1 more.")
s2 = Step("leftovers", "Called by AppView::start_updates. Calls replaced_name.")
