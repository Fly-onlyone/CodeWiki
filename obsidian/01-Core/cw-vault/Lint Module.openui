root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "11")
f1 = Stat("Used by notes", "5")
f2 = Stat("Depends on notes", "4")
flow = Steps([s0, s1, s2, s3])
s0 = Step("is_line_ref", "Called by clean_line, label.")
s1 = Step("max_words", "Called by guidance.")
s2 = Step("lint", "Called by generate_with. Calls Note::parse, then extract_links, then max_words, then lint_lines.")
s3 = Step("link_resolution_rate", "Called by generate_with. Calls Note::parse.")
