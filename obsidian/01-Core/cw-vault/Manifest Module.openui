root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "7")
f1 = Stat("Used by notes", "5")
f2 = Stat("Depends on notes", "3")
flow = Steps([s0, s1])
s0 = Step("body_hash", "Called by state, approve and 3 more. Calls sha256_hex, then normalize_text.")
s1 = Step("Manifest::default", "Called by VaultMeta::load.")
