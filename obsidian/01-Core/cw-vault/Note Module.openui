root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "5")
f1 = Stat("Used by notes", "2")
f2 = Stat("Depends on notes", "0")
flow = Steps([s0, s1, s2, s3])
s0 = Step("extract_links", "Called by lint, Note::parse.")
s1 = Step("push_line", "Called by Note::parse.")
s2 = Step("parse_tags", "Called by Note::parse.")
s3 = Step("count_words", "Called by Note::parse.")
