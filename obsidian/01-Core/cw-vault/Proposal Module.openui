root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "10")
f1 = Stat("Used by notes", "6")
f2 = Stat("Depends on notes", "4")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("list", "Called by run, list_proposals and 3 more. Calls proposals_dir, then Error::io, then read_json.")
s1 = Step("approve", "Called by run, approve_proposal. Calls get, then Error::invalid, then Error::io, then body_hash and 2 more.")
s2 = Step("reject", "Called by run, reject_proposal. Calls get, then Error::invalid, then write_json.")
s3 = Step("create", "Called by generate_with. Calls proposals_dir, then Error::io, then list, then remove and 4 more.")
s4 = Step("get", "Called by get_proposal. Calls check_id, then proposals_dir, then Error::not_found, then read_json.")
