root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "12")
f1 = Stat("Used by notes", "3")
f2 = Stat("Depends on notes", "7")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("import", "Called by run, coverage and 1 more. Calls Error::not_found, then Error::io, then import_text.")
s1 = Step("save", "Called by run, import_coverage. Calls Error::external.")
s2 = Step("load", "Called by run, coverage.")
s3 = Step("report", "Called by run, coverage and 1 more. Calls load, then hotspots, then is_test_path.")
s4 = Step("import_text", "Called by import_coverage. Calls parse, then normalize, then resolve, then percent and 1 more.")
