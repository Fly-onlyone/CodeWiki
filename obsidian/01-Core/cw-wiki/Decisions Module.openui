root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "8")
f1 = Stat("Used by notes", "4")
f2 = Stat("Depends on notes", "8")
flow = Steps([s0, s1, s2])
s0 = Step("list", "Called by run, list_decisions and 1 more. Calls load, then is_adr_path, then build, then VaultMeta::load and 1 more.")
s1 = Step("create", "Called by run, create_decision. Calls sanitize_name, then Error::invalid, then Error::io.")
s2 = Step("why", "Called by run, why. Calls Error::not_found, then list, then VaultMeta::load, then Note::parse and 1 more.")
