root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "5")
f1 = Stat("Used by notes", "2")
f2 = Stat("Depends on notes", "2")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("first_sentence", "Called by items, RenderCtx::render_crate and 1 more. Calls first_paragraph, then sentence_break, then ensure_period.")
s1 = Step("ensure_period", "Called by RenderCtx::render_integration, RenderCtx::summary.")
s2 = Step("clean_inline", "Called by RenderCtx::render_integration, RenderCtx::summary.")
s3 = Step("doc_body", "Called by RenderCtx::render_crate, RenderCtx::render_module and 2 more. Calls blocks, then clean_line, then sentence_break.")
s4 = Step("item_text", "Called by items. Calls blocks, then ensure_period, then clean_line.")
