root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "12")
f1 = Stat("Used by notes", "5")
f2 = Stat("Depends on notes", "11")
flow = Steps([s0, s1, s2])
s0 = Step("file_health", "Called by run, file_health and 2 more. Calls dead_code, then parameter_count.")
s1 = Step("dead_code", "Called by run, dead_code and 1 more. Calls is_test_symbol, then Language::from_path.")
s2 = Step("doc_drift", "Called by run, doc_drift and 1 more. Calls VaultMeta::load, then state, then Note::parse, then looks_like_path.")
