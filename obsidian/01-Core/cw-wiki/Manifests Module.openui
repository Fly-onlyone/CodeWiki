root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "7")
f1 = Stat("Used by notes", "5")
f2 = Stat("Depends on notes", "8")
flow = Steps([s0, s1, s2])
s0 = Step("Packages::read", "Called by Repo::at. Calls locked_versions.")
s1 = Step("declared", "Called by RenderCtx::illustration, RenderCtx::render_integration. Calls cargo, then other.")
s2 = Step("describe", "Called by generate_with. Calls load, then Language::from_path, then declared, then saved_path and 2 more.")
