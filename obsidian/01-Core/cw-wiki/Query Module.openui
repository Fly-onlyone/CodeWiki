root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "21")
f1 = Stat("Used by notes", "3")
f2 = Stat("Depends on notes", "20")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("status", "Called by repo_status, summarize. Calls VaultMeta::load, then head_commit, then list, then vault_is_behind.")
s1 = Step("answer", "Called by answer, ask. Calls Note::parse.")
s2 = Step("list_notes", "Called by list_notes. Calls VaultMeta::load, then info.")
s3 = Step("read_note_as", "Called by read_note. Calls VaultMeta::load, then title_of, then Error::not_found, then check_vault_path and 4 more.")
s4 = Step("write_note", "Called by write_note. Calls check_vault_path, then VaultMeta::load, then Error::not_found, then Error::io.")
