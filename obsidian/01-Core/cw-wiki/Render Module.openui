root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "2")
f1 = Stat("Used by notes", "2")
f2 = Stat("Depends on notes", "4")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("lower_first", "Called by items, RenderCtx::render_crate and 2 more.")
s1 = Step("Doc::new", "Called by RenderCtx::render. Calls front.")
s2 = Step("front", "Called by RenderCtx::render_home, RenderCtx::render_index.")
s3 = Step("zone_label", "Called by RenderCtx::link.")
s4 = Step("top_children", "Called by RenderCtx::summary.")
