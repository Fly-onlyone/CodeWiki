f1 = Stat("Used by notes", "6")
f2 = Stat("Depends on notes", "1")
flow = Steps([s0, s1, s2, s3])
s0 = Step("is_test_path", "Called by scan, scan_source and 8 more.")
s1 = Step("mask", "Called by Scanned::new. Calls blank, then string, then char_or_lifetime, then is_ident and 1 more.")
s2 = Step("matching", "Called by Scanned::matching, Scanned::statement_end.")
s3 = Step("find_tests", "Called by Scanned::new. Calls matching, then classify, then fn_name.")
