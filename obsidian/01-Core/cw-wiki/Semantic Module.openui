root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "13")
f1 = Stat("Used by notes", "11")
f2 = Stat("Depends on notes", "9")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("configure_in", "Called by serve, switch and 1 more.")
s1 = Step("configure", "Called by run, run.")
s2 = Step("built", "Called by Slot::configure_in, Slot::get.")
s3 = Step("embedder", "Called by run.")
s4 = Step("text_of", "Called by Run::plan.")
