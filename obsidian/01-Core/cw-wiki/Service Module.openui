root = Card([figures, flow])
figures = Grid([f0, f1, f2], 3)
f0 = Stat("Public items", "11")
f1 = Stat("Used by notes", "6")
f2 = Stat("Depends on notes", "17")
flow = Steps([s0, s1, s2, s3, s4])
s0 = Step("open_index_in", "Called by Repo::index, open. Calls built, then Index::open, then index_path_in.")
s1 = Step("reindex", "Called by run, reindex_repo. Calls scan_repo, then analyze, then refresh, then head_commit and 2 more.")
s2 = Step("open_index", "Called by run. Calls built, then Index::open, then index_path.")
s3 = Step("open_existing_index_in", "Called by after_update, embed_repo and 1 more. Calls index_path_in, then Index::open.")
s4 = Step("index_notes", "Called by approve_proposal, write_note. Calls VaultMeta::load, then Note::parse, then refresh.")
