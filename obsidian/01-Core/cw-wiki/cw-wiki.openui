root = Card([summary, figures, chart], "cw-wiki")
summary = TextContent("Concept selection and wiki generation pipeline for CodeWiki.", "muted")
figures = Grid([f0, f1, f2, f3], 4)
f0 = Stat("Modules", "34")
f1 = Stat("Public types", "72")
f2 = Stat("Functions", "384")
f3 = Stat("Used by crates", "3")
chart = BarChart(["render", "security", "plan", "semantic", "contracts", "gitintel", "refactor", "units"], [Series("Symbols per module", [48, 44, 38, 38, 35, 29, 28, 28])], "Symbols per module")
